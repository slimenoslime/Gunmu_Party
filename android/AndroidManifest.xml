<?xml version="1.0" encoding="utf-8"?>
<!--
  《滚木派对》安卓清单。

  本作是纯离线单机派对游戏：
    · 不申请任何权限（无网络、无存储、无传感器）
    · 横屏 sensorLandscape
    · 全屏无标题栏（见 res/values/styles.xml 的 GdxTheme）

  extractNativeLibs 必须与"原生库怎么打进包"自洽：它们是**压缩**进包的
  （tools/build_apk.py 用 DEFLATED），只有写成 true，安装阶段才会把 .so
  解到应用目录；否则系统按"必须未压缩 + 页对齐"处理，loadLibrary 直接失败，
  表现是**一点就退**。这条由 build_apk.py 的 check_native_packaging() 守着。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 手柄（可选）：声明为可选硬件，缺了也能装 -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:appCategory="game"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:theme="@style/GdxTheme">

        <activity
            android:name="top.gunmu.party.android.AndroidLauncher"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:theme="@style/GdxTheme"
            android:configChanges="mcc|mnc|keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale|touchscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
