<?xml version="1.0" encoding="utf-8"?>
<!--
  《滚木派对》图标前景：一根带年轮的滚木 + 速度线。
  纯矢量（VectorDrawable），不引入任何位图资源。
  自适应图标标准：108x108 视口，安全区在中央 72x72（即 18..90）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 速度线 -->
    <path
        android:pathData="M20,48 L36,48"
        android:strokeColor="#8A6239"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M16,58 L33,58"
        android:strokeColor="#C79A62"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M22,68 L36,68"
        android:strokeColor="#8A6239"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- 滚木主体（横躺圆柱） -->
    <path
        android:pathData="M40,44 L72,44 A14,14 0 0 1 72,72 L40,72 A14,14 0 0 1 40,44 Z"
        android:fillColor="#A9784A" />

    <!-- 木纹 -->
    <path
        android:pathData="M44,50 L70,50"
        android:strokeColor="#8A6239"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M44,66 L70,66"
        android:strokeColor="#8A6239"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M44,58 L66,58"
        android:strokeColor="#C79A62"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />

    <!-- 端面 + 年轮 -->
    <path
        android:pathData="M72,44 A14,14 0 1 1 72,72 A14,14 0 1 1 72,44 Z"
        android:fillColor="#6E4A2C" />
    <path
        android:pathData="M72,49 A9,9 0 1 1 72,67 A9,9 0 1 1 72,49 Z"
        android:fillColor="#8A6239" />
    <path
        android:pathData="M72,53 A5,5 0 1 1 72,63 A5,5 0 1 1 72,53 Z"
        android:fillColor="#6E4A2C" />
    <path
        android:pathData="M72,56.5 A1.6,1.6 0 1 1 72,59.5 A1.6,1.6 0 1 1 72,56.5 Z"
        android:fillColor="#C79A62" />

</vector>
